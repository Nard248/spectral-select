  "Inclusion": {
   "additionalProperties": false,
   "description": "A heterogeneity embedded in a layered block (e.g. a blood vessel, a tumour nodule, a\nfluorescent bead), in the BLOCK's local frame (footprint centred on x = z = 0, bottom y = 0).\n\n* ``sphere``: centre ``center_mm``, radius ``radius_mm``.\n* ``ellipsoid``: centre, semi-axes ``semi_axes_mm`` (x, y, z).\n* ``cylinder``: axis through ``center_mm`` along local ``axis`` (x or z), radius ``radius_mm``,\n  length ``length_mm`` (clipped to the block) \u2014 a vessel.\n* ``box``: centre, full ``size_mm``.\n\nThe inclusion REPLACES the layer material wherever it overlaps the block (the part outside the\nblock is ignored). In the 3D Monte Carlo it is voxelised at\n``acquisition.volume_mc.inclusion_voxel_mm`` and treated as **index-matched** to the\nsurrounding layer (its ``refractive_index`` is not used for refraction; documented\napproximation, standard in voxel MC such as mcxyz). Its dyes fluoresce like any layer.",
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "material_id": {
     "title": "Material Id",
     "type": "string"
    },
    "kind": {
     "default": "sphere",
     "enum": [
      "sphere",
      "ellipsoid",
      "cylinder",
      "box"
     ],
     "title": "Kind",
     "type": "string"
    },
    "center_mm": {
     "default": [
      0.0,
      1.0,
      0.0
     ],
     "maxItems": 3,
     "minItems": 3,
     "title": "Center Mm",
     "type": "array",
     "items": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "additionalItems": false
    },
    "radius_mm": {
     "default": 1.0,
     "exclusiveMinimum": 0,
     "title": "Radius Mm",
     "type": "number"
    },
    "semi_axes_mm": {
     "default": [
      1.0,
      0.5,
      1.0
     ],
     "maxItems": 3,
     "minItems": 3,
     "title": "Semi Axes Mm",
     "type": "array",
     "items": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "additionalItems": false
    },
    "size_mm": {
     "default": [
      2.0,
      1.0,
      2.0
     ],
     "maxItems": 3,
     "minItems": 3,
     "title": "Size Mm",
     "type": "array",
     "items": [
      {
       "type": "number"
      },
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "additionalItems": false
    },
    "axis": {
     "default": "z",
     "enum": [
      "x",
      "z"
     ],
     "title": "Axis",
     "type": "string"
    },
    "length_mm": {
     "default": 1000.0,
     "exclusiveMinimum": 0,
     "title": "Length Mm",
     "type": "number"
    }
   },
   "required": [
    "name",
    "material_id",
    "kind",
    "center_mm",
    "radius_mm",
    "semi_axes_mm",
    "size_mm",
    "axis",
    "length_mm"
   ],
   "title": "Inclusion",
   "type": "object"
  },
  "LayeredBlockShape": {
   "additionalProperties": false,
   "description": "A rectangular block built from a stack of uniform layers, listed BOTTOM \u2192 TOP. Footprint\n``footprint_mm = (x, z)`` centred on the local origin; the bottom face lies on local ``y = 0``\nand every layer interface ``y = \u03a3_{j\u2264i} t_j(x, z)`` is a plane (uniform or linear profiles).\nLight transport inside is solved by the 3D layered Monte Carlo (``transport3d``), so buried\nlayers (e.g. a fluorophore under a scattering cover) are seen through everything above them.\n``SceneObject.material_id`` is ignored for this shape (each layer carries its own material).",
   "properties": {
    "kind": {
     "const": "layered_block",
     "default": "layered_block",
     "title": "Kind",
     "type": "string"
    },
    "footprint_mm": {
     "default": [
      40.0,
      40.0
     ],
     "maxItems": 2,
     "minItems": 2,
     "title": "Footprint Mm",
     "type": "array",
     "items": [
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "additionalItems": false
    },
    "layers": {
     "items": {
      "$ref": "#/$defs/BlockLayer"
     },
     "maxItems": 8,
     "minItems": 1,
     "title": "Layers",
     "type": "array"
    },
    "inclusions": {
     "items": {
      "$ref": "#/$defs/Inclusion"
     },
     "maxItems": 16,
     "title": "Inclusions",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "footprint_mm",
    "layers",
    "inclusions"
   ],
   "title": "LayeredBlockShape",
   "type": "object"
  },
