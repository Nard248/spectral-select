{
 "$defs": {
  "AbsorberSpec": {
   "additionalProperties": false,
   "description": "Non-fluorescent background absorption added to the dyes' absorption.\n\n``preset`` spectra are tabulated in :mod:`spectraforge.studio.spectra`; ``scale`` multiplies\nthem (for ``water`` scale 1 = pure water; for ``hemoglobin`` / ``melanin`` scale is the\nabsorption coefficient at 500 nm in 1/mm). ``custom`` is a list of ``(nm, mua_per_mm)``.",
   "properties": {
    "preset": {
     "default": "none",
     "enum": [
      "none",
      "water",
      "hemoglobin",
      "melanin",
      "carbon_black",
      "custom"
     ],
     "title": "Preset",
     "type": "string"
    },
    "scale": {
     "default": 1.0,
     "minimum": 0,
     "title": "Scale",
     "type": "number"
    },
    "custom": {
     "items": {
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "items": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "additionalItems": false
     },
     "title": "Custom",
     "type": "array"
    }
   },
   "required": [
    "preset",
    "scale",
    "custom"
   ],
   "title": "AbsorberSpec",
   "type": "object"
  },
  "AcquisitionSettings": {
