  "ScatteringSpec": {
   "additionalProperties": false,
   "description": "Reduced scattering (1/mm) with Henyey-Greenstein anisotropy ``g`` (``mus = mus' / (1 - g)``).\n\n* ``power_law``: ``mus'(\u03bb) = mus_prime_500 \u00b7 (\u03bb/500 nm)^-power_b``.\n* ``mie_rayleigh`` (Jacques 2013, Phys. Med. Biol. 58 R37, eq. 2):\n  ``mus'(\u03bb) = mus_prime_500 \u00b7 [f_rayleigh (\u03bb/500)^-4 + (1 - f_rayleigh) (\u03bb/500)^-power_b]``\n  (``power_b`` is then the Mie power ``b_Mie``).\n* ``none``: clear medium.",
   "properties": {
    "model": {
     "default": "none",
     "enum": [
      "none",
      "power_law",
      "mie_rayleigh"
     ],
     "title": "Model",
     "type": "string"
    },
    "mus_prime_500_per_mm": {
     "default": 0.0,
     "minimum": 0,
     "title": "Mus Prime 500 Per Mm",
     "type": "number"
    },
    "power_b": {
     "default": 1.0,
     "minimum": 0,
     "title": "Power B",
     "type": "number"
    },
    "f_rayleigh": {
     "default": 0.0,
     "maximum": 1,
     "minimum": 0,
     "title": "F Rayleigh",
     "type": "number"
    },
    "g": {
     "default": 0.9,
     "maximum": 0.99,
     "minimum": -0.99,
     "title": "G",
     "type": "number"
    }
   },
   "required": [
    "model",
    "mus_prime_500_per_mm",
    "power_b",
    "f_rayleigh",
    "g"
   ],
   "title": "ScatteringSpec",
   "type": "object"
  },
